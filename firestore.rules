rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lista antiga (usada só na migração para registros individuais)
    match /airsoft/roster {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Marca de migração concluída
    match /airsoft/meta {
      allow read, write: if true;
    }
    // Cada jogador e cada suplente é um registro próprio: todos leem, adicionam e editam nomes
    // Apagar um nome: só admin logado (vaga de suplente vazia qualquer um pode remover)
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if request.auth != null;
    }
    match /subs/{subId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if request.auth != null || resource.data.name == '';
    }
    // Informações do jogo (dia, local, valores, PIX): todos leem, só admin logado edita
    match /airsoft/event {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Líderes principais (leader1Id/leader2Id): qualquer pessoa escolhe e todos veem em tempo real.
    // Nomes das equipes: só admin logado.
    match /airsoft/draw_setup {
      allow read: if true;
      allow write: if request.auth != null
        || (resource == null && request.resource.data.keys().hasOnly(['leader1Id', 'leader2Id']))
        || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leader1Id', 'leader2Id']));
    }
    // Segundo e terceiro líderes (ocultos): só admin logado
    match /airsoft/draw_setup_admin {
      allow read, write: if request.auth != null;
    }
    // Resultado público do sorteio: qualquer pessoa sorteia e todos veem em tempo real
    match /airsoft/draw {
      allow read, write: if true;
    }
    // Resultado completo do sorteio (com 2º líder): só admin logado
    match /airsoft/draw_admin {
      allow read, write: if request.auth != null;
    }
  }
}
